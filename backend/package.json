{
  "name": "kapehtrace-backend",
  "version": "1.0.0",
  "description": "Backend API REST y Orquestador Políglota (PostgreSQL + MongoDB + Neo4j) para KapehTrace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test:types": "tsc --noEmit"
  },
  "keywords": [
    "kapehtrace",
    "specialty-coffee",
    "polyglot-persistence",
    "postgresql",
    "mongodb",
    "neo4j",
    "typescript",
    "express"
  ],
  "author": "Equipo KapehTrace - UPChiapas",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "neo4j-driver": "^5.27.0",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.7",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
