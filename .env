# ==============================================================================
# KapehTrace - Variables de Entorno de Ejemplo
# Proyecto Integrador de Bases de Datos - Universidad Politécnica de Chiapas
# ==============================================================================

# Entorno y Puerto de la API REST
NODE_ENV=production
API_PORT=8000

# 1. Base Relacional (PostgreSQL)
# Nota: Si el backend corre en Docker, POSTGRES_HOST es 'postgres'. Si corre en host local, es 'localhost'.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kapeh_trace_db
POSTGRES_USER=kapeh_admin
POSTGRES_PASSWORD=kapeh_secret_2026

# 2. Base Documental (MongoDB)
# Nota: Si el backend corre en Docker, MONGO_HOST es 'mongodb'. Si corre en host local, es 'localhost'.
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=kapeh_trace_docs
MONGO_USER=kapeh_admin
MONGO_PASSWORD=kapeh_secret_2026

# 3. Base de Grafos (Neo4j)
# Nota: Si el backend corre en Docker, NEO4J_HOST es 'neo4j'. Si corre en host local, es 'localhost'.
NEO4J_HOST=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kapeh_secret_2026
